# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Go coverage tool output
*.out

# Go workspace file
go.work

# Keep vendored generated files
!vendor/**/zz_generated.*

# Editor / IDE
.idea
.vscode
*.swp
*.swo
*~

# May contain secrets
*.kubeconfig
.kube/

docs/session-memory/
docs/*HANDOFF*.md
docs/sprints/SPRINT*-VM-*.md

# Compiled binaries at repo root — keep these anchored with a leading '/'.
# An unanchored bare name matches every path component of that name anywhere
# in the tree (e.g. a bare `agent` pattern would swallow all of internal/agent/).
/local_gate
/pm-cni
/fleetctl
/agent
/hack/gate-workload/gate-server

# macOS
.DS_Store
**/.DS_Store

.claude/settings.local.json
CLAUDE.md
AGENTS.md
docs/AGENTIC_STRATEGY*.md

/HANDOFF-LOG.md
docs/sprint46-finish.js
docs/sprints/
docs/personas/
docs/audit/
docs/review/
docs/postmortems/
docs/process/
docs/chaos/
docs/cncf/
docs/compliance/
docs/memory/

docs/LIVE-E2E-EVIDENCE-*.md

docs/proof/*-STATE.yaml

.internal/

SPRINT*-PHASE-*-GATE-*.md
docs/adr/PROOF_NS5_BETA_SPRINT_GATE.md

# 0205/0206/0207 are the only ADRs at these numbers (verified) — safe as a range.
# ADR-0226 uses the OTHER "ADR-"-prefixed naming convention this repo also uses
# for ~9 legitimate public ADRs, so it stays a specific exclusion, not a wildcard.
docs/adr/020[5-7]-*.md
docs/adr/ADR-0226-*.md

docs/sprint-workflow-skeleton.js
docs/self-heal-workflow-skeleton.js
docs/design/SELF-HEAL-WORKFLOW-MONITORING.md
docs/STRATEGY-REVIEW-*.md
docs/NORTH_STAR_SPRINT_PLAN.md
docs/FELN_SPRINT_PLAN.md
docs/SPRINT_PLAN.md
docs/SPRINT_PLAN_M19_M25.md
docs/ns4-revolutionary-plan.md
docs/AWS_COST_PLAN.md
docs/VALIDATION_AND_CERTIFICATION_PLAN.md

bin/

# eBPF compiled objects
*.o

# Python
__pycache__/
*.pyc

# Windows line-ending artifact
LF

# `**` so this also reaches nested dirs (e.g. docs/proof/archive/.../*.md) —
# a single `*` stops at a path segment and previously missed those.
docs/proof/**/*-GATE-*ATTEMPT-*.md
docs/proof/SPRINT40-S1-PROOF.md

docs/SPRINT*-PLAN.md
docs/WORKSTREAM-*.md

.github/workflows/disclose-check.yaml
docs/design/PREAUTHOR-GATE-DEADEND-ANALYSIS.md
docs/design/DEV-PHASE-INTERDEP-HARDENING.md
docs/design/SPRINT-CONVERGENCE-POSTMORTEM.md
docs/personas/k8s-oss-developer.md

docs/converged/
docs/design/HUMAN-CHECKPOINT-MINIMIZATION-OPTIONS.md
docs/design/quorum-transcripts/

# docs/design/ and docs/security/ mix a handful of legitimately public files in
# with internal-only ones. Default-deny + allowlist the known-public files is both
# shorter than listing every internal filename AND safer going forward — a new
# internal file dropped into either directory is private by default.
docs/design/
!docs/design/headless-service-migration-matrix.md

docs/security/
!docs/security/SECURITY-ARCHITECTURE.md
!docs/security/podmotion-usb-backup.service
!docs/security/podmotion-usb-backup.timer
!docs/security/usb-backup.sh

# Terraform local state, generated keys, provider cache.
# Configs (.tf) and .terraform.lock.hcl are meant to be tracked.
terraform/**/.terraform/
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.backup
terraform/**/*.tfvars
terraform/**/crash.log
terraform/**/override.tf
terraform/**/override.tf.json
terraform/**/*.pem
terraform/**/*_rsa
terraform/**/*_rsa.pub
terraform/**/tfplan
terraform/**/hosts.env
terraform/**/kubeconfig

# Packer build output — churns every build, not meant to be tracked
images/capi/packer/manifest.json
