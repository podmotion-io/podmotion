{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PodMotionSpotReclamation",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSpotInstanceRequests"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}"
        }
      }
    },
    {
      "Sid": "PodMotionAgentBinaryDownload",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::${PODMOTION_BUCKET}/podmotion/releases/*"
    },
    {
      "Sid": "PodMotionCheckpointStorage",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${PODMOTION_CHECKPOINT_BUCKET}",
        "arn:aws:s3:::${PODMOTION_CHECKPOINT_BUCKET}/*"
      ]
    }
  ]
}
