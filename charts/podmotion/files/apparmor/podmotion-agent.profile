#include <tunables/global>

profile podmotion-agent flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # Base confinement mirrors containerd's shipped default profile
  # (cri-containerd.apparmor.d, generated by containerd's built-in
  # contrib/apparmor template and loaded directly via the AppArmor API on
  # all 3 KVM nodes — it has no on-disk source file, confirmed in Dev by
  # `aa-status` showing it loaded/enforce with no matching /etc/apparmor.d
  # file — see the ADR-0300 runtime-dependency audit) so nothing already
  # denied by the container-runtime default becomes newly permitted here.
  # This profile is strictly ADDITIVE.
  file,
  network,
  capability,
  mount,
  remount,
  umount,
  pivot_root,
  signal (send, receive) peer=podmotion-agent,
  ptrace (read, trace) peer=podmotion-agent,

  # The single narrow allow this profile exists for: mustEnsureCheckpointTmpfs
  # (cmd/agent/main.go:88-108) statfs's /proc/1/root/run/podmotion/checkpoints
  # through the host PID-1 mount namespace (hostPID: true). The kernel routes
  # this /proc/<pid>/... cross-namespace read through a ptrace_may_access
  # gate, which AppArmor mediates under the "ptrace" class as a read against
  # the target's peer label. Host PID 1 runs unconfined (no AppArmor label),
  # so the peer is "unconfined" — this is the exact ADR-0299 denial signature:
  #   apparmor="DENIED" operation="ptrace" class="ptrace"
  #   profile="cri-containerd.apparmor.d" peer="unconfined" requested_mask="read"
  ptrace (read) peer=unconfined,

  deny @{PROC}/sys/kernel/** wklx,
  deny /sys/[^f]*/** wklx,
}
