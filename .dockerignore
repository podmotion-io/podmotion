# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include operator and agent binaries
!bin/manager-linux-amd64
!bin/agent-linux-amd64

# Re-include pycriu Python package (required by agent Dockerfile)
!pycriu/
!pycriu/**

# Re-include compiled BPF objects (eBPF ELF relocatables for kind node image)
!bpf/zero_window_bpfel.o
!bpf/zero_window_bpfeb.o

!images/capi/ansible/roles/podmotion-node/files/nri.toml
!images/capi/ansible/roles/podmotion-node/files/sys-fs-bpf.mount
